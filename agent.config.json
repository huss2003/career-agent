      { "label": "Dev roles that use AI tools", "params": { "category": "ai_engineering,fullstack,frontend,software_engineering,creative", "skills": "claude-code,github-copilot,cursor,claude,chatgpt,openai,agentic-ai,llm,generative-ai,prompt-engineering,rag,mcp,langchain,n8n,zapier,ai-enablement" } },
      { "label": "AI automation", "params": { "q": "AI automation" } },
      { "label": "AI website builder", "params": { "q": "AI website builder" } },
      { "label": "Creative developer", "params": { "q": "creative developer GSAP" } }
    ]
  },

  "scoring": {
