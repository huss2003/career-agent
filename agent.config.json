{
  "_comment": "Settings for the job agent. Edit freely; the workflow reads this file on every run.",

  "model": "claude-sonnet-5-5",
  "jobs_per_run": 5,
  "parallel_workers": 2,
  "min_scan_score": 6,

  "freehire": {
    "open_within_days": 3,
    "first_run_open_within_days": 14,
    "locations": [
      { "label": "India", "params": { "countries": "in" } },
      { "label": "Remote (global / APAC)", "params": { "work_mode": "remote", "regions": "global,apac" } }
    ],
    "common_params": {
      "seniority": "junior,middle,senior",
      "seniority_include_unspecified": "true",
      "experience_years_max": "5",
      "experience_include_unspecified": "true",
      "role_type_exclude": "people_manager",
      "reality_exclude": "stale",
      "sort": "posted_at",
      "order": "desc",
      "limit": "100",
      "description_format": "markdown"
